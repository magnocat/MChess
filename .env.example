# MChess - Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env.local para uso local.
# Nunca envie arquivos .env reais para o GitHub.

# Caminho base da aplicação (use /MChess/ para GitHub Pages ou / para servidor local)
VITE_BASE_PATH=/MChess/

# Hash SHA-256 da senha exclusiva do ADMIN (padrão de demonstração: "admin-mchess-2026")
# Gere um novo hash com: node -e "console.log(require('crypto').createHash('sha256').update('SUA_SENHA').digest('hex'))"
VITE_ADMIN_PASS_HASH=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918

# Servidor STUN público opcional para WebRTC P2P (PeerJS)
VITE_STUN_SERVER=stun:stun.l.google.com:19302
